[Unit]
Description=Persistent Caelestia → Zen Browser accent sync
After=graphical-session.target caelestia-shell.service
Wants=caelestia-shell.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/libexec/qwqc-zen-accent-sync --watch --interval 1
Restart=always
RestartSec=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
